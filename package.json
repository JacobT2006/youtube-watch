{
  "name": "youtube-watch",
  "publisher": "JacobToepfer",
  "displayName": "youtube-watch",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.140.0"
  },
  "extensionKind": [
    "ui"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:youtubeWatcher.home",
    "onCommand:youtube-watch.openYouTube",
    "onCommand:youtube-watch.chooseBrowser"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "youtube-watch.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "youtube-watch.openYouTube",
        "title": "YouTube: Open in Browser"
      },
      {
        "command": "youtube-watch.chooseBrowser",
        "title": "YouTube: Choose Browser"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "youtubeWatcher",
          "title": "YouTube",
          "icon": "media/youtube-icon.svg"
        }
      ]
    },
    "views": {
      "youtubeWatcher": [
        {
          "id": "youtubeWatcher.home",
          "name": "YouTube"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.140.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "open": "^8.4.2"
  }
}
